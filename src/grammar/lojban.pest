// =====================================================================
// ロジバン PEG 文法
// 原典: zantufa-1.9999.peg (guskant/gerna_cipra) を Rust/pest 向けに移植
//
// 移植方針:
// - zantufa のルール名・構造を可能な限り踏襲する
// - WHITESPACE ルールは定義しない(ポーズ=空白・. , ! ? は意味を持つため
//   sp ルールで明示管理する)
// - 補助ルールは silent(_{}) にして解析木を清潔に保つ
// - 語彙リスト(cmavo 各クラス)は実験的 cmavo を除く標準 CLL 系の主要語に絞った
//   (拡張は各クラスの選択肢に追加するだけでよい)
// =====================================================================

// ---------------------------------------------------------------------
// 統語層(zantufa の text/statement/sentence/sumti/selbri 構造をコアサブセット
// として移植。トークン間のポーズは sp1 で明示接続する。
// 接続詞(gek/ek/gihek/joik)・mex・引用(LU/ZO/ZOI/LOhU)も実装済み。
// 以降の拡張履歴は STATUS.md を参照)
// ---------------------------------------------------------------------
text = { SOI ~ sp0 ~ content? ~ sp0 ~ EOI }

content = { lead? ~ item ~ ( sp1 ~ sep_conn ~ sp1 ~ item
                          | sp1 ~ sep_bare ~ (sp1 ~ item)? )* }
// 注: 後続 item を任意にできるのは裸区切り(.i / ni'o)のみ(zantufa 準拠)。
//     接続詞付き(.ije / .ibo / .ijanai 等)の後の文は必須で、
//     「.i je」のような宙吊り接続詞は拒否される
lead    = _{ sep ~ sp1 }
sep     = { sep_conn | sep_bare }
// 注: 順序選択により sep_conn の第一枝が裸 I を先取りするため、
//     このラッパー内で sep_bare の I_clause 枝は到達不能(NIhO のみ実質有効)
// 接続詞付きの文区切り。「後続の文は必須」は content ループ内でのみ真で、
// 文頭の lead 経由では従来どおり後続に文があればよい(省略時は lead 全体が巻き戻る)
sep_conn = _{ I_clause ~ (sp1 ~ JA_clause)? ~ (sp1 ~ NAI_clause)? ~ (sp1 ~ BO_clause)?
            | IBO_joint | IJ_joint }
// 裸の区切り(.i / ni'o)。発話の末尾に来られる(後続の文は任意)
sep_bare = _{ I_clause | NIhO_clause }
// .ije / .ijanai 等の結合表記(I+JA が一語に綴られる)
IJ_joint = { ^"i" ~ !space_char ~ JA_bare ~ (NAI_clause)? ~ &word_boundary }
// I+BO の結合表記(.ibo = 目的接続。.ijebo = I+JE+BO)
IBO_joint = @{ (^"ibo" | ^"ijebo") ~ &word_boundary }
// UI+NAI の結合表記(ta'onai ba'anai 等の談話標識否定形)
UINAI_joint = @{ (^"ta'onai" | ^"ja'onai" | ^"ku'inai" | ^"po'onai"
                | ^"da'inai" | ^"je'unai" | ^"la'anai" | ^"za'anai"
                | ^"ga'inai" | ^"zu'unai" | ^"ba'anai" | ^"ju'onai"
                | ^"cu'inai" | ^"ji'anai" | ^"ru'anai" | ^"ehinai" | ^"e'inai"
                | ^"ihinai" | ^"i'inai" | ^"ohanai" | ^"o'anai" | ^"kahunai"
                | ^"ka'unai" | ^"a'unai" | ^"u'inai" | ^"u'unai") ~ &word_boundary }
item    = { gek_sentence | prenex_sentence | sentence | free | Y_clause
          | fragment | tense_item }
// 前置スコープ(su'o da zo'u … / ro da zo'u …)。論理の量化を文に前置する。
// 項は「量化詞+代名詞」の単純形に制限(完全な terms を使うと
// item 失敗パスのたびに rafsi バックトラックが再試行され
// ファジングで指数時間になるため。v0.30 教訓)
prenex_sentence = { prenex_terms ~ sp1 ~ ZOhU_clause ~ sp1 ~ inner_sentence }
prenex_terms    = _{ prenex_term ~ (sp1 ~ prenex_term)* }
prenex_term     = _{ PA_seq | PA_clause | KOhA_clause }
// 末尾の否定先読み: 項解析が na_ku だけで部分確定する入力(naku pu /
// na ku ba 等)を tense_item に譲る。受理済み入力では item の直後は
// 区切りか終端のみのため、既存の解析木は不変
fragment  = { terms ~ (sp1 ~ VAU_clause)? ~ (sp1 ~ free)? ~ !(sp1 ~ tense_mark) }
// 裸時制の発話フラグメント。連鎖(mo'i ni'a mo'i ni'a 等)を1項として
// 受理するため単一の tense_mark ではなく連鎖規則の tense_marks を使う。
// VAU 後置(mo'i ni'a vau 等)は zantufa の fragment(terms ~ VAU_elidible)相当
// 注: ku 付き形は fragment(tagged)経路が先行するため本規則の KU 枝は実質予備
tense_item = { tense_marks ~ (sp1 ~ VAU_clause)? }

sentence   = { frees_s? ~ sp1? ~ tense_marks? ~ sp1? ~ (terms_full | bridi_tail) ~ frees_m? }
terms_full = { terms ~ (sp1 ~ CU_clause)? ~ sp1 ~ frees_mid? ~ bridi_tail }
frees_mid  = _{ free ~ (sp1 ~ free)* }

// 項間・項前後の自由修飾語を許容(mi .ui do tavla)。
// CEhE 明示区切りと PEhE 項グループ接続は tail_terms と共用(silent で木形状不変)
terms = { terms_items ~ (sp1 ~ free)* }
// 項と自由修飾語を同一ループで混在させる。区切りは必ずループ内の sp1 が
// 一度だけ消費する形にする((sp1 ~ X)? の失敗で sp1 が巻き戻ると
// 次の要素が空白から始められない — 教訓5裏面)
terms_items = _{ terms_atom ~ (sp1 ~ terms_atom)* }
terms_atom  = _{ free | term
               | CEhE_clause ~ sp1 ~ term
               | PEhE_clause ~ sp1 ~ pehe_conn ~ sp1 ~ term }
// pe'e 後の接続詞(論理 je / 非論理 joi / 間隔 bi'o 等。camxes joik_jek 準拠)
pehe_conn = _{ JA_clause | ek_joik }
term  = { tagged | na_ku | termset | sumti }
// 項set(nu'i X Y [nu'u]): 複数項を 1 対象として接続・タグ付けできる
termset = { NUhI_clause ~ sp1 ~ terms ~ (sp1 ~ NUhU_clause)? }
tagged = { FA_clause ~ sp1 ~ sumti
         | (SE_clause ~ sp1)? ~ BAI_clause ~ (sp1 ~ NAI_clause)? ~ sp1 ~ sumti
         | SEBAI_joint ~ sp1 ~ sumti
         | FIhO_clause ~ sp1 ~ selbri ~ (sp1 ~ FEhU_clause)? ~ sp1 ~ sumti
         // タグと sumti 間の自由修飾語を許容(ta'i ba'e ma … 等。
         // zantufa は sumti 先頭語への pre_clause(BAhE)付帯として受理)。
         // frees_mid の後の隙間は sp1? が吸う(教訓5裏面の sp1 配置規約)
         | tense_tags ~ sp1 ~ frees_mid? ~ sp1? ~ sumti ~ (sp1 ~ KU_clause)?
         // 注: 本枝が受けるタグ付き項は term 位置(述語の前)を想定する。
         //     selbri の後ろ(tail_terms)で一致した場合、直後に別の裸 brivla
         //     は続かない(接続詞なしの二重述語は非文)。例:
         //     「mi ponse re ta'e mi klama」は re ta'e mi を tail_terms の
         //     タグ付き項として消費した後、klama に述語の役割が残らず拒否。
         //     zantufa(z0/z1)/camxes もこの形を拒否することを実測済みで
         //     v0.92 と同一挙動のため、受理拡張は行わない
         // タグだけ項(sumti を伴わない明示 ku 閉鎖)。zantufa の
         // tag_term(tag … KU_elidible) 相当。「ba zi ku le gerku klama」の
         // ように [時制+ku] に描述が続く入力は、sentence の tense_marks が
         // 「ba zi ku」まで消費した後、描述の tanru が後続の brivla を貪欲吸収
         // して bridi_tail が空になり失敗する。zantufa はこれを全文ではなく
         // fragment(terms: tag_term + sumti)として受理するため、本枝により
         // 同経路(fragment: tagged(ba zi ku) + desc(le gerku klama))で再現する。
         // 注: sentence 側 tense_marks の末尾 (sp1 ~ KU_clause)? は削除しない。
         //     PEG は選択成功で確定するため文頭の時制連鎖を削ると直後の裸 ku が
         //     項を開始できず(本枝は tense_tags 前置が必須)、かえって
         //     受理不能になる(実測)
         | tense_tags ~ sp1 ~ KU_clause }
// 注: FIhO の fe'u は省略可(selbri は tail_terms を含まないため、
//     直後の sumti との境界が自明)
// 時制マーク連鎖をタグとして使う(pu le cabdei / vi ne'i le zdani 等)。
// 時制マーク語彙と sumti 開始語彙はクラスが分離しているため最長一致で曖昧性なし
tense_tags = _{ tense_mark ~ (sp1 ~ tense_mark)* }
// naku(NA KU)による項位置の否定。結合表記(naku 一語)も IJ_joint 同様に対応
na_ku      = { NAKU_joint | NA_clause ~ sp1 ~ KU_clause }
NAKU_joint = { ^"naku" ~ &word_boundary }

sumti      = { sumti_core ~ (sp1 ~ relative_clauses)?
              ~ ((sp1 ~ ek_joik | sp1 ~ VUhO_clause) ~ sp1 ~ sumti)* }
// 注: 裸の数詞項は直後が MOI 述語(re moi 等)なら項としない。
//     PEG の繰り返しは成功で確定するため、ここで拒否しないと
//     bridi_tail 側の「数詞+MOI」述語が届かない
sumti_core = _{ bu_lerfu | KOhA_clause | lahe_sumti | desc | BY_clause | quant_desc | quant_selbri | bare_number | abstraction
               | lu_quote | zo_quote | gek_sumti | li_mex | zoi_quote }
// 注: 直後が ROI/TAhE/ZAhO の場合は数詞単独の項としない。
//     「so'i re'u」「za'u ro re'u」等の数詞+間隔プロパティは複合タグ
//     (interval_property)だが、fragment の項解析が数詞だけ部分一致して
//     確定すると tense_item 経路が届かなくなるため(PEG の部分成功確定)。
//     数詞+これらの語はタグを成すという CLL 規範とも整合
bare_number = _{ number ~ !(sp1 ~ MOI_clause)
                ~ !(sp1 ~ (ROI_clause | TAhE_clause | ZAhO_clause)) }
quant_selbri = { number ~ sp1 ~ selbri ~ (sp1 ~ KU_clause)? }
// LAhE 項修飾(la'e = 参照先 / lu'e = 参照元)。lu'u による明示閉鎖も許容
// (LAhE の終端は LUhU。ge'u は GOI 関係節の終端)
lahe_sumti = { LAHEDI_joint | LAhE_clause ~ sp1 ~ sumti ~ (sp1 ~ LUhU_clause)? }

desc        = { LE_clause ~ sp1 ~ sumti_tail ~ (sp1 ~ KU_clause)? }
quant_desc  = { number ~ sp1 ~ LE_clause ~ sp1 ~ sumti_tail ~ (sp1 ~ KU_clause)? }
number      = { PA_clause ~ (sp1 ~ PA_clause)* ~ (sp1 ~ BOI_clause)?
              | PA_seq }
abstraction = { abstr_head ~ sp1 ~ inner_sentence ~ (sp1 ~ KEI_clause)? }
inner_sentence = _{ gek_sentence | prenex_sentence | sentence }
abstr_head  = _{ SEDUHU_joint | NU_clause }
// 注: (mex ~ sp1)? ~ selbri だと、mex が成功した後に selbri が失敗した際に
//     グループ成功が確定し「selbri 単独」 reading に戻れない
//     (le re moi prenu で発覚)。分岐で書く(教訓5の裏面)
sumti_tail  = _{ mex ~ sp1 ~ selbri | selbri }

relative_clauses = { relative_clause ~ (sp1 ~ relative_clause)* }
relative_clause  = {
    NOI_clause ~ sp1 ~ inner_sentence ~ (sp1 ~ KUhO_clause)?
  | GOI_clause ~ sp1 ~ sumti ~ (sp1 ~ GEhU_clause)?
}

bridi_tail = { selbri ~ tail_terms ~ (sp1 ~ gihek_link ~ sp1 ~ free* ~ bridi_tail)* }
// 連結部の gihek_link 直後にも自由修飾語を許容(mi klama gi'e .ui cadzu)。
// free は非 silent だが空一致ではノードを生成しないため、UI 等を含まない
// 入力の解析木は不変(BAhE の tanru_unit 前置と同じインライングループ方式)。
// free 語彙(UI/SAhE/COI 等)は selbri を開始しない上、順序選択で free が
// 先に試行されるため競合はない(to'e / se 等の s_mark は語境界により
// TO/SEI が先取りしない)。ループ進行は sp1+gihek_link が保証
// 述語と項の間・項間の自由修飾語を許容(mi cusku .ui do / cusku sei … do)。
// 項リスト本体は terms と共通(CEhE/PEhE 含む)
tail_terms = { (sp1 ~ free)* ~ (sp1 ~ terms_items)? ~ (sp1 ~ free)* ~ (sp1 ~ VAU_clause)? }

selbri  = { s_marks? ~ sp1? ~ tense_marks? ~ sp1? ~ s_marks? ~ sp1? ~ tanru ~ co_tail?
          | (NAhE_clause ~ sp1)? ~ guhek_selbri }
// 述語の先接続(gu'e X gi Y 等。camxes の selbri_6 相当)
guhek_selbri = { GUhA_clause ~ (sp1 ~ NAI_clause)? ~ sp1 ~ selbri ~ sp1 ~ gi_joint
                 ~ sp1 ~ selbri }
co_tail = _{ sp1 ~ CO_clause ~ sp1 ~ s_marks? ~ tanru }
s_marks = _{ s_mark ~ (sp1 ~ s_mark)* }
s_mark  = { NA_clause | JAhA_clause | SE_clause | NAhE_clause }

// 時制・相・方位の連続(zantufa の tag/tense の簡略版。ku による明示閉鎖も許容)
tense_marks = _{ tense_mark ~ (sp1 ~ tense_mark)* ~ (sp1 ~ KU_clause)? }
// 各タグの直後に BO(短スコープ結合)を許容(zantufa の tag? BO_clause 相当)。
// 「.i ni'i bo …」「ni'o ki'u bo …」の文頭タグ+BO と「mi pu bo klama」等の
// selbri 前タグ+BO を一様に受理する。tense_mark は silent なので既存入力
// (タグの後に BO が来ない入力)の解析木は不変。BO はタグ位置でのみ試行され、
// tanru の BO 接続(selbri_6 相当・未実装)や sep の .i bo とは競合しない
// 注: 「mi pu bo klama」は z0/z1 とも拒否する本パーサーの意図的拡張(受容優先)。
//     宙吊り pu bo フラグメントも副次的に受理する(tests/syntax.rs の受容ピン参照)
tense_mark  = _{ (PU_clause | CAhA_clause | ZAhO_clause | ZI_clause | VA_clause
               | TAhE_clause | ROI_clause | BAI_clause ~ (sp1 ~ NAI_clause)?
               | MOhI_clause ~ sp1 ~ FAhA_clause | FAhA_clause
               | NA_clause ~ sp1 ~ KU_clause | NAKU_joint
               | CUhE_clause | KI_clause | ROROI_joint
               // 数詞を前置した ROI/TAhE/ZAhO の複合タグ(so'u roi / re roi 等)
               | interval_property
               | time_interval
               | space_interval) ~ (sp1 ~ BO_clause)? }

// 空間間隔(VEhA/VIhA)。FAhA を後続可(ve'i ne'i le zdani 等)。
// FEhE に続く間隔プロパティ(roi/ta'e/zaho の空間用法)も連鎖可(camxes 準拠)
space_interval = _{ VEhA_clause ~ (sp1 ~ VIhA_clause)?
                     ~ (sp1 ~ FAhA_clause ~ (sp1 ~ NAI_clause)?)?
                     ~ (sp1 ~ FEhE_clause ~ sp1 ~ interval_property)*
                  | VIhA_clause ~ (sp1 ~ FAhA_clause ~ (sp1 ~ NAI_clause)?)?
                     ~ (sp1 ~ FEhE_clause ~ sp1 ~ interval_property)*
                  | FEhE_clause ~ sp1 ~ interval_property
                    ~ (sp1 ~ FEhE_clause ~ sp1 ~ interval_property)* }
// 数詞を前置した ROI/TAhE/ZAhO の複合タグ(so'u roi / re roi 等)。
// 数詞は無空白連結(PA_seq)と空白区切り連鎖(za'u ro re'u / pa za'u re'u 等)
// の両方を許容。注: 選択はグループ単位で確定するため、
// (PA_seq | PA_clause ~ …)? のような括り方は数詞連鎖の読み替えができない
// (教訓5の裏面)。数詞形ごとに完全な分岐で書く
interval_property = _{ PA_seq ~ ip_tail
                     | PA_clause ~ (sp1 ~ PA_clause)* ~ ip_tail
                     | ip_tail }
ip_tail           = _{ sp1? ~ (ROI_clause | TAhE_clause | ZAhO_clause)
                       ~ (sp1 ~ NAI_clause)? }

// 時制間隔(ZEhA): オフセット(PU/ZI)を間隔詞の両端に置く
// (pu bi'o ba = 過去から未来へ渡る、ca bi'i ba = 現在と未来の間、等)
time_interval = _{ (tense_offset ~ sp1)? ~ ZEhA_clause ~ (sp1 ~ tense_offset)? }
tense_offset  = _{ PU_clause | ZI_clause }

tanru      = { tanru_unit ~ (sp1 ~ tanru_link ~ sp1 ~ tanru_unit | sp1 ~ tanru_unit)* }
// ba'e / za'e 強調(BAhE)は各 tanru 単位に前置できる(zantufa の G 準拠)。
// ba'e は「直後の語」を強調するため、単位ごとの前置が意味論に整合。
// 注: ラップは tanru 単位全体(zei 複合や linked_args を含む)に掛かるため、
// camxes の語単位の強調よりスコープが広い
tanru_unit = { (BAhE_clause ~ sp1)? ~ (
     zei_compound ~ (sp1 ~ linked_args)?
   | !("ija" | "ije" | "ijo" | "iju")
   ~ !(GANAI_joint | GINAI_joint | SEBAI_joint | SEDUHU_joint | IBO_joint
     | MAI_core | UI_clause | NAhU_clause | MOhE_clause | UINAI_joint
     | VEhA_clause | VIhA_clause | PEhO_clause | MAhO_clause | KUhE_clause
     | TEhU_clause | ZOhU_clause | MOI_clause | MEhU_clause
     | NUhI_clause | NUhU_clause | FUhE_clause | FUhO_clause | CEhE_clause
     | PEhE_clause | LAHEDI_joint | ROROI_joint | BIhE_clause | FEhE_clause)
   ~ BRIVLA_clause ~ (sp1 ~ linked_args)?
   // 注: 「i+字母」で始まる語(.ije / .ijanai 等の文連結結合形)は tanru の先頭に来ないため除外。
   // 母音始まりの語そのもの(.a'onai 等)は述語のみの文として正当なので許容する
   | GOhA_clause ~ (sp1 ~ linked_args)?
   | CMEVLA_clause
   | nu_form
   | ke_group
   | me_form
   // JAI 変換(jai gau … / jai cau …): タグ付き項を x1 に繰り上げる
   // (camxes tanru_unit_2 の JAI tag? tanru_unit_2 準拠)
   // 注: (sp1 ~ tense_mark)? は失敗時に sp1 の消費も取り消すため
   //     分岐で書く(教訓5の裏面)
   | JAI_clause ~ (sp1 ~ tense_mark ~ sp1 ~ tanru_unit | sp1 ~ tanru_unit)
   // 数詞・文字+MOI(re moi 序数 / ci mei 集合数 等。camxes 準拠)。
   // moi は selbri なので be 連結も可(lo re moi be le ci gerku)
   | number ~ sp1 ~ MOI_clause ~ (sp1 ~ linked_args)?
   | BY_clause ~ sp1 ~ MOI_clause ~ (sp1 ~ linked_args)?
) }

// zei による複合語(zdani zei sinxa = 「家の印」の lujvo 相当)。
// camxes の zei_tail(any_word)+ 準拠だが語は完全な word に制限
zei_compound = { word ~ (sp1 ~ ZEI_clause ~ sp1 ~ word)+ }
nu_form    = { s_marks? ~ sp1? ~ abstr_head ~ sp1 ~ inner_sentence ~ (sp1 ~ KEI_clause)? }
me_form    = { ME_clause ~ sp1 ~ sumti ~ (sp1 ~ MEhU_clause)? ~ (sp1 ~ MOI_clause)? }
ke_group   = { KE_clause ~ sp1 ~ selbri ~ (sp1 ~ KEhE_clause)? }

// BE…BEI による項連結(selbri への内部項の付加。be'o による明示閉鎖も許容)
linked_args = { BE_clause ~ sp1 ~ sumti ~ (sp1 ~ BEI_clause ~ sp1 ~ sumti)* ~ (sp1 ~ BEhO_clause)? }

// 数理表現(mex)。LI...LOhO で sumti 化。演算子は左結合の単純連鎖、括弧は vei...ve'o
// BIhE 以降は残り全体を 1 オペランドとして右結合(camxes mex_1 準拠)
mex         = { mex_items ~ (sp1 ~ BIhE_clause ~ sp1 ~ mex_operator ~ sp1 ~ mex)? }
mex_items   = _{ mex_operand ~ (sp1 ~ mex_operator ~ sp1 ~ mex_operand)* }
mex_operator = _{ (SE_clause ~ sp1)? ~ VUhU_clause | FIhU_clause
                 | NAhU_clause ~ sp1 ~ tanru ~ (sp1 ~ TEhU_clause)?
                 | MAhO_clause ~ sp1 ~ mex ~ (sp1 ~ TEhU_clause)?
                 | BIhI_clause }
mex_operand = _{ number | vei_group | BY_clause | MOhE_clause ~ sp1 ~ sumti
                | peho_group
                // 前置単項演算子(va'a pa = -1 等)。通常の位置では
                // 数詞が先に一致するため既存解析に影響しない
                | VUhU_clause ~ sp1 ~ mex_operand }
// 先置数理(peho su'i re ci = 2+3)。kuhe による明示閉鎖は省略可。
// 被演算子は連結数詞を展開しない単一形(re ci を2桁数と読む number との競合回避)
peho_group  = { PEhO_clause ~ sp1 ~ mex_operator ~ sp1 ~ fore_operand
               ~ sp1 ~ fore_operand ~ (sp1 ~ KUhE_clause)? }
fore_operand = _{ PA_seq | PA_clause | vei_group | BY_clause
                 | MOhE_clause ~ sp1 ~ sumti | peho_group }
vei_group   = { VEI_clause ~ sp0 ~ mex ~ (sp0 ~ VEhO_clause)? }
li_mex      = { LI_clause ~ sp0 ~ mex ~ (sp0 ~ LOhO_clause)? }
// 文字化(任意の語 + bu で文字参照)。sumti_core の先頭で試行し
// bu が続かない場合は速やかにフォールバックする
bu_lerfu    = { word ~ sp1 ~ BU_clause }

// ZOI 引用。本文は lib.rs の前処理で zo'e に正規化される(PEG に後方参照がないため)
zoi_quote   = { ZOI_clause ~ sp1 ~ zoi_token ~ sp1 ~ word ~ sp1 ~ zoi_token }
zoi_token   = @{ (ASCII_ALPHANUMERIC | "." | "," | "!" | "?" | "'")+ }

// 接続詞(後置: A/JOI=項、GIhA=述語連鎖、JA=tanru、I+JA=文。先接続: GA...GI)
ek_joik      = _{ (A_clause | JOI_clause) ~ (sp1 ~ NAI_clause)? ~ (sp1 ~ BO_clause)?
                | (GAhO_clause ~ sp1)? ~ BIhI_clause ~ (sp1 ~ GAhO_clause)?
                  ~ (sp1 ~ NAI_clause)? }
gihek_link   = _{ GIhA_clause ~ (sp1 ~ NAI_clause)? ~ (sp1 ~ BO_clause)? }
tanru_link   = _{ JA_clause ~ (sp1 ~ NAI_clause)? ~ (sp1 ~ BO_clause)? }
// 先接続は GA+NAI の結合形(ganai)と分離形(ga nai)の両方、
// GI 側も gi / ginai / gi nai を受理(CLL 14 の論理接続)
ga_joint = _{ GANAI_joint | GA_clause ~ (sp1 ~ NAI_clause)? }
gi_joint = _{ GINAI_joint | GI_clause ~ (sp1 ~ NAI_clause)? }
// 自由修飾語を先置できる(xu ganai … gi … / pe'i ganai … gi …)。
// 内側も inner_sentence(gek/prenex 入れ子可)
gek_sentence = { frees_s? ~ sp1? ~ ga_joint ~ sp1 ~ inner_sentence
                ~ sp1 ~ gi_joint ~ sp1 ~ inner_sentence }
gek_sumti    = { ga_joint ~ sp1 ~ sumti ~ sp1 ~ gi_joint ~ sp1 ~ sumti }

// 引用(LU...LIhU / ZO+単語は sumti、LOhU...LEhU は free。ZOI は lib.rs 前処理で対応)
lu_quote   = { LU_clause ~ sp0 ~ content ~ sp0 ~ LIhU_clause }
zo_quote   = { ZO_clause ~ sp1 ~ word }
lohu_quote = { LOhU_clause ~ sp0 ~ (!LEhU_clause ~ word) ~ (sp1 ~ !LEhU_clause ~ word)*
               ~ sp0 ~ LEhU_clause }

frees_s   = _{ free ~ (sp1 ~ free)* }
frees_m   = _{ (sp1 ~ free)+ }
free      = { free_unit ~ (sp1 ~ free_unit)* }
free_unit = { ui_free | mai_free | soi_free | sei_free | xi_free | daho_free
           | fuhe_free | fuho_free | faho_free | bae_free
           | to_quote | vocative | lohu_quote | SI_clause | SU_clause }
mai_free  = { MAI_clause }
soi_free  = { SOI_clause ~ sp1 ~ sumti ~ (sp1 ~ sumti)? ~ (sp1 ~ SEhU_clause)? }
// 添字(broda xi re / xi vei re su'i ci)。camxes: XI (number|lerfu)|XI VEI mex VEhO?
xi_free   = { XI_clause ~ sp1 ~ (number | BY_clause | vei_group) }
daho_free = { DAhO_clause }
fuhe_free = { FUhE_clause }
fuho_free = { FUhO_clause }
faho_free = { FAhO_clause }
bae_free  = { BAhE_clause }
ui_free  = { UINAI_joint | UI_clause ~ (sp1 ~ CAI_clause)? ~ (sp1 ~ NAI_clause)? }
sei_free = { SEI_clause ~ sp1 ~ inner_sentence ~ (sp1 ~ SEhU_clause)? }
to_quote = { TO_clause ~ (sp0 ~ (word ~ (sp1 ~ word)*)?)? ~ (sp1 ~ TOI_clause)? }

vocative     = { COI_clause ~ (sp1 ~ NAI_clause)? ~ (sp1 ~ vocative_arg)?
               ~ (sp1 ~ DOhU_clause)? }
vocative_arg = _{ CMEVLA_clause | desc }

// 語ラッパー(後続ポーズを自己消費)
word = { CMEVLA_clause | CMAVO_clause | BRIVLA_clause }

// 1文字以上のポーズ / 0文字以上のポーズ
sp1 = _{ space_char+ }
sp0 = _{ space_char* }

// 語境界: 直後が字母・数字・アポストロフィでないこと(語の後方一致を防ぐ)
word_boundary = _{ !ASCII_ALPHANUMERIC ~ !"'" }

space_char = _{ " " | "\t" | "\n" | "\r" | "." | "," | "!" | "?" }

// ---------------------------------------------------------------------
// 文字レベルの定義(zantufa の子音規則には子音連結の合法性が組み込まれている)
// ---------------------------------------------------------------------
a = _{ "a" | "A" }
e = _{ "e" | "E" }
i = _{ "i" | "I" }
o = _{ "o" | "O" }
u = _{ "u" | "U" }
y = _{ ("y" | "Y") ~ !(!("y" | "Y") ~ nucleus) }

l = _{ ("l" | "L") ~ !h ~ !glide ~ !("l" | "L") }
m = _{ ("m" | "M") ~ !h ~ !glide ~ !("m" | "M") }
n = _{ ("n" | "N") ~ !h ~ !glide ~ !("n" | "N") ~ !affricate }
r = _{ ("r" | "R") ~ !h ~ !glide ~ !("r" | "R") }
b = _{ ("b" | "B") ~ !h ~ !glide ~ !("b" | "B") ~ !unvoiced }
d = _{ ("d" | "D") ~ !h ~ !glide ~ !("d" | "D") ~ !unvoiced }
g = _{ ("g" | "G") ~ !h ~ !glide ~ !("g" | "G") ~ !unvoiced }
v = _{ ("v" | "V") ~ !h ~ !glide ~ !("v" | "V") ~ !unvoiced }
j = _{ ("j" | "J") ~ !h ~ !glide ~ !("j" | "J") ~ !("z" | "Z") ~ !unvoiced }
z = _{ ("z" | "Z") ~ !h ~ !glide ~ !("z" | "Z") ~ !("j" | "J") ~ !unvoiced }
s = _{ ("s" | "S") ~ !h ~ !glide ~ !("s" | "S") ~ !("c" | "C") ~ !voiced }
c = _{ ("c" | "C") ~ !h ~ !glide ~ !("c" | "C") ~ !("s" | "S") ~ !("x" | "X") ~ !voiced }
x = _{ ("x" | "X") ~ !h ~ !glide ~ !("x" | "X") ~ !("c" | "C") ~ !("k" | "K") ~ !voiced }
k = _{ ("k" | "K") ~ !h ~ !glide ~ !("k" | "K") ~ !("x" | "X") ~ !voiced }
f = _{ ("f" | "F") ~ !h ~ !glide ~ !("f" | "F") ~ !voiced }
p = _{ ("p" | "P") ~ !h ~ !glide ~ !("p" | "P") ~ !voiced }
t = _{ ("t" | "T") ~ !h ~ !glide ~ !("t" | "T") ~ !voiced }

consonant = _{ voiced | unvoiced | syllabic }
syllabic  = _{ l | m | n | r }
voiced    = _{ b | d | g | j | v | z }
unvoiced  = _{ c | f | k | p | s | t | x }

affricate = _{ t ~ c | t ~ s | d ~ j | d ~ z }
liquid    = _{ l | r }
other     = _{ p | t ~ !l | k | f | x | b | d ~ !l | g | v | m | n ~ !liquid }
sibilant  = _{ c | s ~ !x | (j | z) ~ !n ~ !liquid }

initial = _{ ( affricate | (sibilant? ~ other? ~ liquid?) ) ~ !consonant ~ !glide }
initial_pair = _{ &initial ~ consonant ~ consonant ~ !consonant }

onset  = _{ h | glide | initial }
nucleus = _{ vowel | diphthong | y ~ !nucleus }
vowel  = _{ (a | e | i | o | u) ~ !nucleus }
diphthong = _{ (a ~ i ~ !i | a ~ u ~ !u | e ~ i ~ !i | o ~ i ~ !i) ~ !nucleus }
glide  = _{ (i | u) ~ &nucleus }
h      = _{ ("'" | "h") ~ &nucleus }

cluster = _{ consonant ~ consonant+ }

// ---------------------------------------------------------------------
// 音節・ストレス(zantufa の stress 先読み機構)
// ---------------------------------------------------------------------
any_syllable          = _{ onset ~ nucleus ~ coda? | consonantal_syllable }
syllable              = _{ onset ~ !y ~ nucleus ~ coda? }
consonantal_syllable  = _{ consonant ~ &syllabic ~ coda }
coda                  = _{ !any_syllable ~ consonant ~ &any_syllable | syllabic? ~ consonant? ~ &pause }
final_syllable        = _{ onset ~ !y ~ !stressed ~ nucleus ~ !cmevla ~ &word_boundary }

stress            = _{ (consonant | glide)* ~ h? ~ y? ~ syllable ~ pause }
stressed          = _{ onset ~ ("A" | "E" | "I" | "O" | "U") }
stressed_syllable = _{ &stressed ~ syllable | syllable ~ &stress }
stressed_diphthong = _{ &stressed ~ diphthong | diphthong ~ &stress }
stressed_vowel    = _{ &stressed ~ vowel | vowel ~ &stress }

unstressed_syllable  = _{ !stressed ~ syllable ~ !stress | consonantal_syllable }
unstressed_diphthong = _{ !stressed ~ diphthong ~ !stress }
unstressed_vowel     = _{ !stressed ~ vowel ~ !stress }

// ---------------------------------------------------------------------
// ポーズ・単語境界
// ---------------------------------------------------------------------
pause     = _{ space_char+ | EOF_rule }
EOF_rule  = _{ !ANY }

// ---------------------------------------------------------------------
// 形態論: cmavo / cmevla / brivla / rafsi
// ---------------------------------------------------------------------
cmavo = _{ !cmevla ~ !CVCy_lujvo ~ cmavo_form ~ &word_boundary }

cmavo_form = _{
    !h ~ !cluster ~ onset ~ (nucleus ~ h)* ~ (!stressed ~ nucleus | nucleus ~ !cluster)
    | y+
}

CVCy_lujvo = _{
    CVC_rafsi ~ y ~ h? ~ initial_rafsi* ~ brivla_core
    | stressed_CVC_rafsi ~ y ~ short_final_rafsi
}

cmevla = _{ jbocme | zifcme }
jbocme = _{ &zifcme ~ any_syllable* ~ &pause }
zifcme = _{ !h ~ (nucleus | glide | h | consonant ~ !pause)* ~ consonant ~ &pause }

brivla = _{ !cmavo ~ initial_rafsi* ~ brivla_core }
BRIVLA = _{ gismu_2 | lujvo | fuhivla }
gismu_2 = _{ gismu }
// 注: かつて !gismu ~ !fuhivla の否定先読みがあったが、BRIVLA の選択順序
// (gismu_2 | lujvo | fuhivla)と全ルールがサイレントであることから受理集合は
// 不変のため削除(否定先読みが全体解析を繰り返し大幅に遅かった)
lujvo = _{ brivla }

brivla_core = _{ gismu | CVV_final_rafsi | stressed_initial_rafsi ~ short_final_rafsi | fuhivla }
stressed_initial_rafsi = _{ stressed_extended_rafsi | stressed_y_rafsi | stressed_y_less_rafsi }
initial_rafsi = _{ extended_rafsi | y_rafsi | !any_extended_rafsi ~ y_less_rafsi ~ !any_extended_rafsi }
// 注: 否定先読み(!any_extended_rafsi)から頻繁に呼ばれるため、
// 高価な fuhivla を最後に(受理集合は不変・全サイレントルール)
any_extended_rafsi = _{ extended_rafsi | stressed_extended_rafsi | fuhivla }
extended_rafsi = _{ brivla_rafsi | fuhivla_rafsi }
stressed_extended_rafsi = _{ stressed_brivla_rafsi | stressed_fuhivla_rafsi }

stressed_brivla_rafsi = _{ &unstressed_syllable ~ brivla_head ~ stressed_syllable ~ h ~ y }
brivla_rafsi = _{ &(syllable ~ consonantal_syllable* ~ syllable) ~ brivla_head ~ h ~ y ~ h? }
stressed_fuhivla_rafsi = _{ fuhivla_head ~ stressed_syllable ~ consonantal_syllable* ~ !h ~ onset ~ y }
fuhivla_rafsi = _{ &unstressed_syllable ~ fuhivla_head ~ !h ~ onset ~ y ~ h? }

fuhivla = _{ fuhivla_head ~ stressed_syllable ~ consonantal_syllable* ~ final_syllable }
fuhivla_head = _{ !rafsi_string ~ brivla_head }
brivla_head = _{ !cmavo ~ !slinkuhi ~ !h ~ &onset ~ unstressed_syllable* }
slinkuhi = _{ !rafsi_string ~ consonant ~ rafsi_string }
rafsi_string = _{
    y_less_rafsi*
    ~ ( gismu | CVV_final_rafsi | stressed_y_less_rafsi ~ short_final_rafsi | y_rafsi
      | stressed_y_rafsi | stressed_y_less_rafsi? ~ initial_pair ~ y
      | hy_rafsi | stressed_hy_rafsi )
}

gismu = _{
    ( initial_pair ~ stressed_vowel | consonant ~ stressed_vowel ~ consonant )
    ~ &final_syllable ~ consonant ~ vowel ~ &word_boundary
}
CVV_final_rafsi = _{ consonant ~ stressed_vowel ~ h ~ &final_syllable ~ vowel ~ &word_boundary }
short_final_rafsi = _{ &final_syllable ~ (consonant ~ diphthong | initial_pair ~ vowel) ~ &word_boundary }

stressed_y_rafsi = _{ (stressed_long_rafsi | stressed_CVC_rafsi) ~ y }
stressed_y_less_rafsi = _{ stressed_CVC_rafsi ~ !y | stressed_CCV_rafsi | stressed_CVV_rafsi }
stressed_long_rafsi = _{ initial_pair ~ stressed_vowel ~ consonant | consonant ~ stressed_vowel ~ consonant ~ consonant }
stressed_CVC_rafsi = _{ consonant ~ stressed_vowel ~ consonant }
stressed_CCV_rafsi = _{ initial_pair ~ stressed_vowel }
stressed_CVV_rafsi = _{ consonant ~ (unstressed_vowel ~ h ~ stressed_vowel | stressed_diphthong) ~ r_hyphen? }

y_rafsi = _{ (long_rafsi | CVC_rafsi) ~ y ~ h? }
y_less_rafsi = _{ !y_rafsi ~ !stressed_y_rafsi ~ !hy_rafsi ~ !stressed_hy_rafsi ~ (CVC_rafsi | CCV_rafsi | CVV_rafsi) ~ !h }
hy_rafsi = _{ (long_rafsi ~ vowel | CCV_rafsi | CVV_rafsi) ~ h ~ y ~ h? }
stressed_hy_rafsi = _{ (long_rafsi ~ stressed_vowel | stressed_CCV_rafsi | stressed_CVV_rafsi) ~ h ~ y }

long_rafsi = _{ initial_pair ~ unstressed_vowel ~ consonant | consonant ~ unstressed_vowel ~ consonant ~ consonant }
CVC_rafsi = _{ consonant ~ unstressed_vowel ~ consonant }
CCV_rafsi = _{ initial_pair ~ unstressed_vowel }
CVV_rafsi = _{ consonant ~ (unstressed_vowel ~ h ~ unstressed_vowel | unstressed_diphthong) ~ r_hyphen? }
r_hyphen = _{ r ~ &consonant | n ~ &r }

// ---------------------------------------------------------------------
// cmavo クラス(標準 CLL 系の主要語。アポストロフィ付き語は ^"...\" 表記)
// ---------------------------------------------------------------------
A_core = @{ ( "a" | "e" | "o" | "u") ~ &word_boundary }
// 注: tai は様態タグ(selma'o TAI)。zantufa の BAI:tai として記述内 tanru 等に現れる
BAI_core = @{ (^"bau" | ^"bai" | ^"cau" | ^"cu'u" | ^"mu'i" | ^"mu'u" | ^"ni'i"
               | ^"ri'a" | ^"ta'i" | ^"tai" | ^"ki'u" | ^"kai" | ^"pa'u" | ^"se'o" | ^"si'u"
               | ^"va'o" | ^"zu'e" | ^"ja'e" | ^"ra'i" | ^"ri'i" | ^"de'i" | ^"du'o"
               | ^"fau" | ^"ka'a" | ^"gau" | ^"piho" | ^"pi'o"
               | ^"cihu" | ^"ci'u" | ^"pu'a"
               | ^"jihe" | ^"ji'e" | ^"jihu" | ^"ji'u" | ^"jiho" | ^"ji'o"
               | ^"raha" | ^"ra'a") ~ &word_boundary }
BE_core = @{ ( ^"be") ~ &word_boundary }
BEI_core = @{ ( ^"bei") ~ &word_boundary }
BEhO_core = @{ ( ^"be'o" | ^"beho") ~ &word_boundary }
BO_core = @{ ( ^"bo") ~ &word_boundary }
BOI_core = @{ ( ^"boi") ~ &word_boundary }
CO_core = @{ ( ^"co") ~ &word_boundary }
COI_core = @{ (^"coi" | ^"co'o" | ^"je'e" | ^"ju'i" | ^"re'i" | ^"nu'e" | ^"fi'i"
               | ^"fe'o" | ^"mu'o" | ^"mi'e" | ^"ta'a" | ^"pe'u" | ^"ki'e"
               | ^"viho" | ^"vi'o" | ^"keho" | ^"ke'o" | ^"doi") ~ &word_boundary }
CU_core = @{ ( ^"cu") ~ &word_boundary }
DOhU_core = @{ ( ^"do'u" | ^"dohu") ~ &word_boundary }
FA_core = @{ ( ^"fi'a" | ^"fa" | ^"fe" | ^"fi" | ^"fo" | ^"fu") ~ &word_boundary }
FAhA_core = @{ (^"ca'u" | ^"cahu" | ^"ti'a" | ^"tiha" | ^"zu'a" | ^"zuha"
              | ^"ga'u" | ^"gahu" | ^"ni'a" | ^"niha" | ^"ru'u" | ^"ruhu"
              | ^"ne'i" | ^"pa'o" | ^"paho" | ^"te'e" | ^"ne'a" | ^"re'o") ~ &word_boundary }
MOhI_core = @{ ( ^"mo'i" | ^"mohi") ~ &word_boundary }
FAhO_core = @{ ( ^"fa'o" | ^"faho") ~ &word_boundary }
FEhU_core = @{ ( ^"fe'u" | ^"fehu") ~ &word_boundary }
FIhO_core = @{ ( ^"fi'o" | ^"fiho") ~ &word_boundary }
GA_core = @{ ( ^"ga" | ^"ge" | ^"go" | ^"gu") ~ &word_boundary }
// GA+NAI / GI+NAI の結合表記(ganai … ginai 等。IJ_joint 同様の一体化形)
GANAI_joint = @{ (^"ganai" | ^"genai" | ^"gonai" | ^"gunai") ~ &word_boundary }
GINAI_joint = @{ (^"ginai") ~ &word_boundary }
GAhO_core = @{ ( ^"ke'i" | ^"kehi" | ^"ga'o" | ^"gaho") ~ &word_boundary }
GEhU_core = @{ ( ^"ge'u" | ^"gehu") ~ &word_boundary }
GI_core = @{ ( ^"gi") ~ &word_boundary }
GIhA_core = @{ ( ^"gi'a" | ^"gi'e" | ^"gi'i" | ^"gi'o" | ^"gi'u") ~ &word_boundary }
GIhI_core = @{ ( ^"gihi") ~ &word_boundary }
GOI_core = @{ ( ^"po'e" | ^"po'u" | ^"no'u" | ^"goi" | ^"pe" | ^"po" | ^"ne") ~ &word_boundary }
GOhA_core = @{ ( ^"go'i" | ^"go'o" | ^"nei" | ^"ra'o" | ^"du" | ^"mo") ~ &word_boundary }
I_core = @{ ( ^"i") ~ &word_boundary }
BIhI_core = @{ ( ^"bi'o" | ^"bi'i" | ^"mi'i") ~ &word_boundary }
VUhU_core = @{ ( ^"su'i" | ^"vu'u" | ^"pi'i" | ^"fe'i" | ^"gei" | ^"de'o" | ^"te'o"
               | ^"re'a" | ^"va'a" | ^"pa'i" | ^"si'i" | ^"fu'u") ~ &word_boundary }
NAhU_core = @{ (^"na'u" | ^"nahu") ~ &word_boundary }
// 除算スラッシュ(pa fi'u re = 1/2)
FIhU_core = @{ (^"fihu" | ^"fi'u") ~ &word_boundary }
// 演算子強調(bi'e: 直後の演算子を右側にグルーピング)
BIhE_core = @{ (^"bihe" | ^"bi'e") ~ &word_boundary }
// 空間間隔プロパティの導入(roi/ta'e/zaho を空間用法に転用)
FEhE_core = @{ (^"fehe" | ^"fe'e") ~ &word_boundary }
PEhO_core = @{ (^"peho" | ^"pe'o") ~ &word_boundary }
MAhO_core = @{ (^"maho" | ^"ma'o") ~ &word_boundary }
KUhE_core = @{ (^"kuhe" | ^"ku'e") ~ &word_boundary }
TEhU_core = @{ (^"tehu" | ^"te'u") ~ &word_boundary }
MOhE_core = @{ (^"mo'e" | ^"mohe") ~ &word_boundary }
VEI_core  = @{ ( ^"vei") ~ &word_boundary }
VEhO_core = @{ ( ^"ve'o" | ^"veho") ~ &word_boundary }
NAhU_clause = { NAhU_core }
PEhO_clause = { PEhO_core }
FIhU_clause = { FIhU_core }
BIhE_clause = { BIhE_core }
FEhE_clause = { FEhE_core }
MAhO_clause = { MAhO_core }
KUhE_clause = { KUhE_core }
TEhU_clause = { TEhU_core }
MOhE_clause = { MOhE_core }
LOhO_core = @{ ( ^"lo'o" | ^"loho") ~ &word_boundary }
BY_core   = @{ (^"by" | ^"cy" | ^"dy" | ^"fy" | ^"gy" | ^"jy" | ^"ky" | ^"ly"
              | ^"my" | ^"ny" | ^"py" | ^"ry" | ^"sy" | ^"ty" | ^"vy" | ^"xy"
              | ^"zy" | ^"abu" | ^"ebu" | ^"ibu" | ^"obu" | ^"ubu" | ^"ybu")
              ~ &word_boundary }
BU_core   = @{ ( ^"bu") ~ &word_boundary }
GUhA_core = @{ ( ^"gu'a" | ^"gu'e" | ^"gu'o" | ^"gu'u") ~ &word_boundary }
SI_core   = @{ ( ^"si") ~ &word_boundary }
SU_core   = @{ ( ^"su") ~ &word_boundary }
JA_core = @{ ( ^"ja" | ^"je" | ^"jo" | ^"ju") ~ &word_boundary }
// 結合形(.ijanai 等)用: 語境界ガードなしの素の JA
JA_bare = _{ ^"ja" | ^"je" | ^"jo" | ^"ju" }
JOI_core = @{ ( ^"jo'e" | ^"joi" | ^"fa'u" | ^"ku'a" | ^"johu" | ^"jo'u") ~ &word_boundary }
KE_core = @{ ( ^"ke") ~ &word_boundary }
KEhE_core = @{ ( ^"ke'e" | ^"kehe") ~ &word_boundary }
KEI_core = @{ ( ^"kei") ~ &word_boundary }
// 注: アポストロフィ付き形は必ずその素の接頭辞(mi/do/di 等)より先に置く。
//      素の形が先だと境界先読みで失敗した際に後続の長い形が試されない
//      (pest の文字列選択のクセ。最小再現済み。既存語もこの順序に従っていた)
KOhA_core = @{ (^"zo'e" | ^"zu'i" | ^"ke'a" | ^"mi'o" | ^"ko'a" | ^"ko'e" | ^"ko'i"
               | ^"ko'o" | ^"ko'u" | ^"fo'a" | ^"fo'e" | ^"fo'i" | ^"fo'o" | ^"fo'u"
               | ^"vo'a" | ^"vo'e" | ^"vo'i" | ^"vo'o" | ^"vo'u"
               | ^"mi'ai" | ^"miahi" | ^"mi'a" | ^"ma'a" | ^"do'o" | ^"tu'a" | ^"dei"
               | ^"di'u" | ^"dihu" | ^"de'u" | ^"dehu" | ^"da'u" | ^"dahu"
               | ^"mi" | ^"do" | ^"ti" | ^"ta" | ^"tu" | ^"ri" | ^"ra" | ^"ru" | ^"ko"
               | ^"ma" | ^"da" | ^"de" | ^"di") ~ &word_boundary }
KU_core = @{ ( ^"ku") ~ &word_boundary }
KUhO_core = @{ ( ^"ku'o" | ^"kuho") ~ &word_boundary }
LAhE_core = @{ ( ^"la'e" | ^"lu'e") ~ &word_boundary }
LE_core = @{ ( ^"le'i" | ^"lo'i" | ^"la'i" | ^"lei" | ^"loi" | ^"lai"
              | ^"lo'e" | ^"lehe" | ^"le'e"
              | ^"le" | ^"lo" | ^"la") ~ &word_boundary }
LEhU_core = @{ ( ^"le'u" | ^"lehu") ~ &word_boundary }
LI_core = @{ ( ^"li") ~ &word_boundary }
// li'u は LU 引用の終端詞(zantufa の命名踏襲)
LIhU_core = @{ ( ^"li'u" | ^"lihu") ~ &word_boundary }
LOhU_core = @{ ( ^"lo'u" | ^"lohu") ~ &word_boundary }
LU_core = @{ ( ^"lu") ~ &word_boundary }
// LUhU(la'e/lu'e 参照の明示閉鎖)。かつて li'u と語形共有していたが、
// 本来の語形 lu'u に修正(CLL 6.7 / zantufa 準拠)
LUhU_core = @{ ( ^"lu'u" | ^"luhu") ~ &word_boundary }
NA_core = @{ ( ^"na") ~ &word_boundary }
JAhA_core = @{ ( ^"ja'a" | ^"jaha") ~ &word_boundary }
NAhE_core = @{ ( ^"na'e" | ^"to'e" | ^"no'e" | ^"je'a") ~ &word_boundary }
NIhO_core = @{ ( ^"ni'o" | ^"niho") ~ &word_boundary }
NOI_core = @{ ( ^"poi" | ^"noi" | ^"voi") ~ &word_boundary }
// si'o(概念抽象)は zantufa 由来の語彙に欠けている NU セルマォの1語(CLL 準拠で補完)
NU_core = @{ ( ^"je'i" | ^"mu'e" | ^"pu'u" | ^"zu'o" | ^"li'i" | ^"su'u" | ^"si'o" | ^"du'u" | ^"nu" | ^"ka" | ^"ni") ~ &word_boundary }
// SE+NU の結合表記(報話で高頻度の sedu'u)。素の形が先だと境界先読みで失敗するため
// joint を先に試行(教訓6)。tanru_unit の BRIVLA ガードにも追加(fu'ivla 誤認防止)
SEDUHU_joint = @{ (^"sedu'u" | ^"seduhu") ~ &word_boundary }
// LAhE+KOhA 結合形(直前の発話の参照先)
LAHEDI_joint = @{ (^"la'edi'u") ~ &word_boundary }
// PA+ROI の結合形(roroi = 常に)
ROROI_joint = @{ (^"roroi") ~ &word_boundary }
// 注: かつて16進桁の jai を収録していたが、JAI 変換(tanru_unit)と
//     衝突するため削除(v0.31。dau fei rei vai は残置)
PA_word  = _{ (^"dau" | ^"fei" | ^"rei" | ^"vai" | ^"so'a" | ^"so'e" | ^"so'i"
               | ^"so'u" | ^"za'u" | ^"su'o" | ^"suhe" | ^"su'e" | ^"daha" | ^"da'a"
               | ^"ji'i" | ^"xo" | ^"pi"
               | ^"pa" | ^"re" | ^"ci" | ^"vo" | ^"mu" | ^"xa" | ^"ze" | ^"bi" | ^"so" | ^"no"
               | ^"ro" | ^"ki'o" | ^"ma'u" | ^"ni'u") }
PA_core  = @{ PA_word ~ &word_boundary }
// 無ポーズ連結数詞(renono = 1200 等)
PA_seq   = @{ PA_word+ ~ &word_boundary }
// roi に同系列の序数頻度タグ re'u を追加(CLL: selma'o ROI)。h 表記 rehu も併記
ROI_core = @{ ( ^"roi" | ^"re'u" | ^"rehu") ~ &word_boundary }
SE_core = @{ ( ^"se" | ^"te" | ^"ve" | ^"xe") ~ &word_boundary }
// SE+BAI の結合表記(pi'o va'u mu'i cau ja'e cu'u ba'i ki'u ri'a ka'a の se 変換)
SEBAI_joint = @{ (^"sepi'o" | ^"sepiho" | ^"seva'u" | ^"sevahu"
                | ^"semu'i" | ^"semuhi" | ^"secau"
                | ^"seja'e" | ^"secu'u" | ^"secuhu"
                | ^"seba'i" | ^"sebahi" | ^"seki'u" | ^"sekihu"
                | ^"seri'a" | ^"seka'a") ~ &word_boundary }
SEI_core = @{ ( ^"sei") ~ &word_boundary }
SEhU_core = @{ ( ^"se'u" | ^"sehu") ~ &word_boundary }
TO_core = @{ ( ^"to") ~ &word_boundary }
TOI_core = @{ ( ^"toi") ~ &word_boundary }
UI_core = @{ (^"u'i" | ^"u'u" | ^"ru'e" | ^"ju'o" | ^"pe'i" | ^"sa'e" | ^"ta'o"
              | ^"e'o" | ^"e'e" | ^"ehu" | ^"e'u" | ^"ohu" | ^"o'u"
              | ^"a'e" | ^"i'a" | ^"buho" | ^"bu'o"
              | ^"kuhi" | ^"ku'i" | ^"ja'o" | ^"po'o" | ^"dahi" | ^"da'i"
              | ^"jehu" | ^"je'u" | ^"laha" | ^"la'a" | ^"zaha" | ^"za'a"
              | ^"gahi" | ^"ga'i" | ^"uho" | ^"u'o" | ^"ihi" | ^"i'i"
              | ^"oha" | ^"o'a" | ^"ehi" | ^"e'i" | ^"kahu" | ^"ka'u" | ^"kau"
              | ^"ruha" | ^"ru'a" | ^"jiha" | ^"ji'a"
              | ^"zuhu" | ^"zu'u" | ^"baha" | ^"ba'a"
              | ^"ai" | ^"au" | ^"kiaha" | ^"ki'a"
               | ^"zo'o" | ^"a'u" | ^"o'o" | ^"u'a" | ^"u'e" | ^"cai"
               | ^"ui" | ^"oi" | ^"ie" | ^"ii" | ^"uu" | ^"ua" | ^"ue" | ^"uo"
               | ^"ia" | ^"iu" | ^"ei" | ^"xu"
               | ^"i'e" | ^"be'e" | ^"be'u" | ^"di'ai" | ^"fau'u" | ^"ge'e"
               | ^"li'a" | ^"ni'au" | ^"pei" | ^"o'i" | ^"su'a") ~ &word_boundary }
VAU_core = @{ ( ^"vau") ~ &word_boundary }
VUhO_core = @{ ( ^"vu'o" | ^"vuho") ~ &word_boundary }
Y_core = @{ ( ("y" | "Y")+) ~ &word_boundary }
NAI_core = @{ ( ^"nai") ~ &word_boundary }
// 発話序数(PA+mai の結合形。.i pamai … / 文末 … pamai)
MAI_core = @{ (^"pamai" | ^"remai" | ^"cimai" | ^"vomai" | ^"mumai"
              | ^"xamai" | ^"zemai" | ^"bimai" | ^"somai" | ^"nomai") ~ &word_boundary }
// 感情強度(CAI): cai=最強 / sai=強 / ru'e=弱 / cu'i=中立
CAI_core = @{ (^"cai" | ^"sai" | ^"ru'e" | ^"ruhe" | ^"cu'i" | ^"cuhi") ~ &word_boundary }
PU_core   = @{ (^"pu" | ^"ca" | ^"ba") ~ &word_boundary }
KI_core   = @{ ( ^"ki") ~ &word_boundary }
CAhA_core = @{ (^"ka'e" | ^"ca'a" | ^"nu'a" | ^"ja'ai") ~ &word_boundary }
CUhE_core = @{ (^"cu'e" | ^"cuhe") ~ &word_boundary }
ZOhU_core = @{ (^"zohu" | ^"zo'u") ~ &word_boundary }
ZAhO_core = @{ (^"pu'o" | ^"co'a" | ^"za'o" | ^"ca'o" | ^"co'u" | ^"mo'u"
               | ^"ba'o" | ^"de'a" | ^"di'a") ~ &word_boundary }
ZI_core   = @{ (^"ze'i" | ^"zehi" | ^"ze'a" | ^"zeha" | ^"ze'u" | ^"zehu"
              | ^"zi" | ^"za" | ^"zu") ~ &word_boundary }
ZEhA_core = @{ (^"zi'i" | ^"zihi" | ^"bi'o" | ^"biho"
              | ^"bi'i" | ^"bihi" | ^"mi'i" | ^"mihi") ~ &word_boundary }
// 空間間隔: VEhA=大きさ(ve'i 微小〜 ve'e 全空間) / VIhA=次元(vi'i 線〜 vi'e 時空)
// (camxes の語形リストを原典確認済み: VEhA=vehu/veha/vehi/vehe, VIhA=vihi/viha/vihu/vihe)
VEhA_core = @{ (^"ve'i" | ^"vehi" | ^"ve'a" | ^"veha"
              | ^"ve'e" | ^"vehe" | ^"ve'u" | ^"vehu") ~ &word_boundary }
VIhA_core = @{ (^"vi'i" | ^"vihi" | ^"vi'a" | ^"viha"
              | ^"vi'u" | ^"vihu" | ^"vi'e" | ^"vihe") ~ &word_boundary }
VA_core   = @{ (^"vi" | ^"va" | ^"vu") ~ &word_boundary }
TAhE_core = @{ (^"ta'e" | ^"di'i" | ^"na'o" | ^"ru'i") ~ &word_boundary }
ME_core   = @{ (^"me") ~ &word_boundary }
JAI_core  = @{ ( ^"jai") ~ &word_boundary }
// 数詞→述語変換(moi 序数 / mei 集合数 / si'e 割合 / cu'o 可能性 / va'e 尺度)
MOI_core  = @{ (^"mei" | ^"moi" | ^"sihe" | ^"si'e"
              | ^"cuho" | ^"cu'o" | ^"vahe" | ^"va'e") ~ &word_boundary }
MEhU_core = @{ (^"mehu" | ^"me'u") ~ &word_boundary }
ZEI_core  = @{ ( ^"zei") ~ &word_boundary }
SOI_core  = @{ ( ^"soi") ~ &word_boundary }
XI_core   = @{ ( ^"xi") ~ &word_boundary }
// 項の明示区切り(camxes terms_2: term (CEhE term)*)
CEhE_core = @{ (^"cehe" | ^"ce'e") ~ &word_boundary }
// 項グループ接続(接続詞の適用範囲を項グループへ)
PEhE_core = @{ (^"pehe" | ^"pe'e") ~ &word_boundary }
// 強調マーカー(次の語を強調。camxes pre_clause 準拠だが
// 受容を優先し独立した自由修飾語として受理)。
// 同 selma'o の za'e(前借り語)も含む
BAhE_core = @{ (^"bahe" | ^"ba'e" | ^"za'e") ~ &word_boundary }
DAhO_core = @{ (^"daho" | ^"da'o") ~ &word_boundary }
// 項set(複数項をまとめて接続対象にする)
NUhI_core = @{ (^"nuhi" | ^"nu'i") ~ &word_boundary }
NUhU_core = @{ (^"nuhu" | ^"nu'u") ~ &word_boundary }
// 感情標識のスコープ(camxes indicators 準拠。スコープ意味論は非モデル)
FUhE_core = @{ (^"fuhe" | ^"fu'e") ~ &word_boundary }
FUhO_core = @{ (^"fuho" | ^"fu'o") ~ &word_boundary }
ZO_core = @{ ( ^"zo") ~ &word_boundary }
ZOI_core = @{ ( ^"zoi") ~ &word_boundary }

// 汎用 cmavo フォールバック(未知だが語形が正しい cmavo を許容)
CMAVO_core = @{ ( cmavo) ~ &word_boundary }
CMEVLA_core = @{ ( cmevla) ~ &word_boundary }
BRIVLA_core = @{ ( BRIVLA) ~ &word_boundary }

// ---------------------------------------------------------------------
// クラスラッパー(コア + 後続ポーズの自己消費)
// ---------------------------------------------------------------------
A_clause = { A_core }
BAI_clause = { BAI_core }
BE_clause = { BE_core }
BEI_clause = { BEI_core }
BEhO_clause = { BEhO_core }
